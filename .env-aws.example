# Copie este arquivo para .env-aws e preencha com as credenciais temporarias da AWS.
# Nao versionar .env-aws com credenciais reais.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS_SESSION_TOKEN é usado para uso do ambiente do Academy.
# AWS_SESSION_TOKEN=

AWS_DEFAULT_REGION=us-east-1

# Nome da stack CloudFormation criada e destruida pela pipeline.
CFN_STACK_NAME=suporte-sla-entrega

# Prefixo usado no nome do bucket. Use apenas letras minusculas, numeros e hifens.
PROJECT_NAME=suporte-sla-entrega

# Prefixo/pasta dentro do bucket.
S3_PREFIX=suporte-sla
